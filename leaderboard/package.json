{
  "name": "agent-office-leaderboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --persist-to .wrangler/state",
    "db:local": "wrangler d1 execute agent-office-leaderboard --local --persist-to .wrangler/state --file schema.sql",
    "db:remote": "wrangler d1 execute agent-office-leaderboard --remote --file schema.sql",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
