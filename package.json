{
  "name": "agent-office-studio",
  "version": "0.5.0",
  "description": "A 3D office where the staff are Claude Code agents.",
  "license": "MIT",
  "files": [
    "bin",
    "dist",
    "server",
    "shared",
    "docs",
    "!docs/proposals",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onuohasilver/agent-office.git"
  },
  "homepage": "https://github.com/onuohasilver/agent-office#readme",
  "bugs": "https://github.com/onuohasilver/agent-office/issues",
  "keywords": [
    "claude",
    "claude-code",
    "agents",
    "ai",
    "three.js",
    "developer-tools"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "agentoffice": "bin/agentoffice.js",
    "agentstudio": "bin/agentoffice.js"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "vite build && node server/supervise.js",
    "voice:model": "mkdir -p data/whisper && curl -L --progress-bar -o data/whisper/ggml-base.en.bin https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.en.bin",
    "voice:piper": "python3 -m venv data/piper/venv && data/piper/venv/bin/pip install -q piper-tts && data/piper/venv/bin/python -m piper.download_voices --data-dir data/piper/voices en_GB-cori-high en_US-amy-medium en_GB-alan-medium en_US-kristin-medium en_US-ryan-high en_GB-alba-medium en_GB-aru-medium en_US-john-medium en_US-hfc_female-medium",
    "test": "node scripts/smoke.mjs && node scripts/guests.mjs",
    "prepack": "vite build"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "concurrently": "10.0.6",
    "marked": "^18.1.0",
    "three": "0.186.1",
    "vite": "6.4.3"
  }
}
