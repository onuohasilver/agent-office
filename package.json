{
  "name": "agent-office-studio",
  "version": "0.1.0",
  "description": "A 3D office where the staff are Claude Code agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onuohasilver/agent-office.git"
  },
  "homepage": "https://github.com/onuohasilver/agent-office#readme",
  "bugs": "https://github.com/onuohasilver/agent-office/issues",
  "keywords": [
    "claude",
    "claude-code",
    "agents",
    "ai",
    "three.js",
    "developer-tools"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "bin": {
    "agent-office-studio": "bin/agent-office.js",
    "agent-office": "bin/agent-office.js"
  },
  "files": [
    "bin/",
    "server/",
    "shared/",
    "dist/"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"node --watch server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "vite build && node server/index.js",
    "test": "node scripts/smoke.mjs",
    "voice": "node bin/agent-office.js voice --data data",
    "prepack": "npm run build"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "concurrently": "10.0.6",
    "marked": "^18.1.0",
    "three": "0.186.1",
    "vite": "6.4.3"
  },
  "optionalDependencies": {
    "node-pty": "1.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
