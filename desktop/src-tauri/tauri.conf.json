{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Office",
  "version": "0.8.1",
  "identifier": "studio.agentoffice.desktop",
  "build": {
    "frontendDist": "../loading"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "A 3D office where the staff are Claude Code agents.",
    "copyright": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "app/": "app/"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "background": "../dmg/background.tiff",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "windowPosition": {
          "x": 200,
          "y": 120
        },
        "appPosition": {
          "x": 165,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 495,
          "y": 190
        }
      }
    }
  }
}
